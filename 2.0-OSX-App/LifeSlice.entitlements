<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox. LifeSlice shells out to /usr/sbin/screencapture and
	     installs a global NSEvent monitor, neither of which survives it. -->

	<!-- Hardened Runtime gates the camera and location even outside the
	     sandbox, so both have to be declared here as well as in Info.plist. -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
</dict>
</plist>
